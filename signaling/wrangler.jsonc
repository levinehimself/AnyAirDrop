{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "anyairdrop-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    { "name": "ICE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "TURN_TTL": "14400"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "anyairdrop.com/ws*", "zone_name": "anyairdrop.com" },
    { "pattern": "www.anyairdrop.com/ws*", "zone_name": "anyairdrop.com" }
  ]
}
