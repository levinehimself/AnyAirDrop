---
import Base from '../layouts/Base.astro';
import TransferTool from '../components/TransferTool.svelte';

const title = 'AnyAirDrop.com: Send Files Between iPhone, Android, Windows and Mac';
const description =
  'Share files between iPhone, Android, Windows and Mac over your Wi-Fi. Free, in the browser, with no app, no upload and no size limit.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://anyairdrop.com/#website',
      url: 'https://anyairdrop.com/',
      name: 'AnyAirDrop.com',
    },
    {
      '@type': 'Organization',
      '@id': 'https://anyairdrop.com/#organization',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      logo: 'https://anyairdrop.com/icon-512.png',
      founder: { '@id': 'https://anyairdrop.com/about/#founder' },
    },
    {
      '@type': 'WebApplication',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any device with a modern browser',
      browserRequirements: 'Requires JavaScript and WebRTC',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://anyairdrop.com/#organization' },
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main>
    <h1>Send files to nearby devices.</h1>
    <p class="lead">Open AnyAirDrop.com on both. Your files go straight across your Wi-Fi.</p>

    <TransferTool client:load />
    <noscript><p class="lead">AnyAirDrop.com needs JavaScript to find nearby devices.</p></noscript>
  </main>
</Base>

<style is:global>
  /* Desktop: the whole homepage fits in the window, with no page scrolling. */
  @media (min-width: 721px) and (min-height: 640px) {
    body {
      height: 100dvh;
      overflow: hidden;
    }

    /* Content never overflows at normal sizes; if a tiny window ever makes it, it can
       still scroll, but without drawing a scrollbar. */
    body > main {
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: none;
    }

    body > main::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead {
    margin: 8px 0 0;
    max-width: 680px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  /* Short desktop windows: a smaller headline keeps the tool in view. */
  @media (min-width: 721px) and (max-height: 780px) {
    h1 {
      font-size: 36px;
    }
  }

  @media (max-width: 720px) {
    main {
      padding-top: var(--space-5);
    }

    h1 {
      font-size: 34px;
    }
  }
</style>
