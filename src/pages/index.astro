---
import Base from '../layouts/Base.astro';
import TransferTool from '../components/TransferTool.svelte';

const title = 'Send Files Like AirDrop Between Any Devices | AnyAirDrop.com';
const description =
  'Share files between iPhone, Android, Windows and Mac over your Wi-Fi. Free, in the browser, with no app, no upload and no size limit.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://anyairdrop.com/#website',
      url: 'https://anyairdrop.com/',
      name: 'AnyAirDrop.com',
    },
    {
      '@type': 'Organization',
      '@id': 'https://anyairdrop.com/#organization',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      logo: 'https://anyairdrop.com/favicon.svg',
    },
    {
      '@type': 'WebApplication',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any device with a modern browser',
      browserRequirements: 'Requires JavaScript and WebRTC',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://anyairdrop.com/#organization' },
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main>
    <h1>Send files to nearby devices.</h1>
    <p class="lead">Open AnyAirDrop.com on both. Your files go straight across your Wi-Fi.</p>

    <TransferTool client:load />
    <noscript><p class="lead">AnyAirDrop.com needs JavaScript to find nearby devices.</p></noscript>

    <ul class="benefits" aria-label="Why AnyAirDrop.com">
      <li><strong>No app or account</strong><span>Works in any browser</span></li>
      <li><strong>Nothing uploaded</strong><span>Device to device, encrypted</span></li>
      <li><strong>No size limit</strong><span>One photo or a whole folder</span></li>
    </ul>
  </main>
</Base>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead {
    margin: 14px 0 0;
    max-width: 520px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .benefits {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: var(--space-6) 0;
    width: 100%;
    max-width: 820px;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .benefits li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .benefits strong {
    font-size: 15px;
    font-weight: 600;
  }

  .benefits span {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    main {
      padding-top: var(--space-5);
    }

    h1 {
      font-size: 34px;
    }

    .benefits {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
