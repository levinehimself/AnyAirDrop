---
import Base from '../layouts/Base.astro';
import TransferTool from '../components/TransferTool.svelte';

const title = 'AnyAirDrop.com: Send Files Between iPhone, Android, Windows and Mac';
const description =
  'Share files between iPhone, Android, Windows and Mac over your Wi-Fi. Free, in the browser, with no app, no upload and no size limit.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://anyairdrop.com/#website',
      url: 'https://anyairdrop.com/',
      name: 'AnyAirDrop.com',
    },
    {
      '@type': 'Organization',
      '@id': 'https://anyairdrop.com/#organization',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      logo: 'https://anyairdrop.com/favicon.svg',
    },
    {
      '@type': 'WebApplication',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any device with a modern browser',
      browserRequirements: 'Requires JavaScript and WebRTC',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://anyairdrop.com/#organization' },
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main>
    <h1>Send files to nearby devices.</h1>
    <p class="lead">Open AnyAirDrop.com on both. Your files go straight across your Wi-Fi.</p>

    <TransferTool client:load />
    <noscript><p class="lead">AnyAirDrop.com needs JavaScript to find nearby devices.</p></noscript>

    <ul class="benefits" aria-label="Why AnyAirDrop.com">
      <li><strong>No app or account</strong><span>Works in any browser</span></li>
      <li><strong>Nothing uploaded</strong><span>Device to device, encrypted</span></li>
      <li><strong>No size limit</strong><span>One photo or a whole folder</span></li>
    </ul>
  </main>
</Base>

<style is:global>
  /* Desktop: the whole homepage fits in the window, with no page scrolling. */
  @media (min-width: 721px) and (min-height: 640px) {
    body {
      height: 100dvh;
      overflow: hidden;
    }

    /* Content never overflows at normal sizes; if a tiny window ever makes it, it can
       still scroll, but without drawing a scrollbar. */
    body > main {
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: none;
    }

    body > main::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 40px;
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead {
    margin: 8px 0 0;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .benefits {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: var(--space-3) 0 var(--space-2);
    width: 100%;
    max-width: 1000px;
    border-top: 1px solid var(--color-line);
    display: flex;
    justify-content: center;
    gap: 8px var(--space-5);
    flex-wrap: wrap;
  }

  .benefits li {
    display: flex;
    gap: 6px;
    align-items: baseline;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .benefits strong {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Short desktop windows: drop the benefit row so the tool stays in view. */
  @media (min-width: 721px) and (max-height: 780px) {
    .benefits {
      display: none;
    }

    h1 {
      font-size: 34px;
    }
  }

  @media (max-width: 720px) {
    main {
      padding-top: var(--space-5);
    }

    h1 {
      font-size: 34px;
    }

    .benefits {
      flex-direction: column;
      align-items: center;
      gap: var(--space-1);
    }
  }
</style>
