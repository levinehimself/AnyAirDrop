---
import Base from '../layouts/Base.astro';
import TransferTool from '../components/TransferTool.svelte';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/blog';

const title = 'AnyAirDrop.com: Send Files Between iPhone, Android, Windows and Mac';
const description =
  'Share files between iPhone, Android, Windows and Mac over your Wi-Fi. Free, in the browser, with no app, no upload and no size limit.';

const faqs = [
  {
    q: 'Is AnyAirDrop.com really free?',
    a: 'Yes. There is nothing to buy, no account to create and no app to install. Open the page on both devices and send.',
  },
  {
    q: 'Do my files get uploaded to a server?',
    a: 'No. When both devices can reach each other, your browser connects straight to the other browser and the file goes device to device. Our server only introduces the two devices, and it never sees your files or their names.',
  },
  {
    q: 'Does it work between an iPhone and an Android phone?',
    a: 'Yes. It runs in the browser, so it works between iPhone, Android, Windows, Mac and Linux, in any combination, as long as both devices have a modern browser.',
  },
  {
    q: 'Is there a limit on file size?',
    a: 'We set no limit. Large files stream across in pieces, so a long video does not have to fit in memory. The practical limit is your Wi-Fi speed and the free space on the receiving device.',
  },
  {
    q: 'Why can’t my devices see each other?',
    a: 'Usually they are on different networks, or the router stops devices from talking to each other (guest networks often do). Pair the devices with the six-digit code or the QR code instead, or follow the step-by-step troubleshooting guide in the blog.',
  },
  {
    q: 'What happens if the network blocks direct connections?',
    a: 'An encrypted relay can carry the transfer instead, and the page tells you when that is happening, so you know the files are not going over your Wi-Fi alone.',
  },
];

const featuredSlugs = [
  'transfer-files-between-pc-and-phone-over-wifi',
  'devices-cant-find-each-other-troubleshooting',
  'is-local-file-transfer-safe-encryption-explained',
  'local-transfer-vs-cloud-upload',
  'why-phone-hotspots-are-slow',
  'how-wifi-works',
];
const allPosts = await getPosts();
const featured = featuredSlugs.map((slug) => allPosts.find((post) => post.id === slug)).filter((post) => post !== undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://anyairdrop.com/#website',
      url: 'https://anyairdrop.com/',
      name: 'AnyAirDrop.com',
    },
    {
      '@type': 'Organization',
      '@id': 'https://anyairdrop.com/#organization',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      logo: 'https://anyairdrop.com/icon-512.png',
      founder: { '@id': 'https://anyairdrop.com/about/#founder' },
    },
    {
      '@type': 'WebApplication',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any device with a modern browser',
      browserRequirements: 'Requires JavaScript and WebRTC',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://anyairdrop.com/#organization' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main>
    <h1>Send files to nearby devices.</h1>
    <p class="lead">Open AnyAirDrop.com on both. Your files go straight across your Wi-Fi.</p>

    <TransferTool client:load />
    <noscript><p class="lead">AnyAirDrop.com needs JavaScript to find nearby devices.</p></noscript>

    <div class="more">
      <section aria-labelledby="how">
        <h2 id="how">How it works</h2>
        <ol class="steps">
          <li>
            <span class="num" aria-hidden="true">1</span>
            <h3>Open it on both devices</h3>
            <p>Visit AnyAirDrop.com on the phone and the computer. Devices on the same Wi-Fi appear on the radar by themselves, each with a random name.</p>
          </li>
          <li>
            <span class="num" aria-hidden="true">2</span>
            <h3>Pick the other device</h3>
            <p>Choose the files and tap the device you want to send to. On a different network, type its six-digit code or scan its QR code.</p>
          </li>
          <li>
            <span class="num" aria-hidden="true">3</span>
            <h3>Accept, and it goes straight across</h3>
            <p>Nothing starts until the receiving device taps Accept. Then the files travel from one browser to the other, encrypted.</p>
          </li>
        </ol>
      </section>

      <section aria-labelledby="why">
        <h2 id="why">Why people use it</h2>
        <dl class="points">
          <div>
            <dt>No app, no account</dt>
            <dd>It runs in the browser you already have, on iPhone, Android, Windows, Mac and Linux. There is nothing to install and nothing to sign up for.</dd>
          </div>
          <div>
            <dt>Device to device</dt>
            <dd>Files are not uploaded to a server and are never stored. They go directly between the two browsers whenever the devices can reach each other.</dd>
          </div>
          <div>
            <dt>Encrypted</dt>
            <dd>The browser encrypts every connection it opens, and a transfer only starts after the receiver accepts it.</dd>
          </div>
          <div>
            <dt>No size limit from us</dt>
            <dd>Large files stream in pieces, so a long video does not have to fit in memory. Photos, videos, documents and whole folders as a ZIP all work.</dd>
          </div>
          <div>
            <dt>Finds devices your way</dt>
            <dd>Automatically on the same Wi-Fi, with a code or QR code across networks, or through trusted devices that find each other every time.</dd>
          </div>
          <div>
            <dt>Honest about the route</dt>
            <dd>The page shows the live speed and tells you plainly if a transfer is going over the internet instead of your Wi-Fi.</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="private">
        <h2 id="private">What our server sees</h2>
        <p>
          Our server only introduces devices to each other. To do that it briefly sees a device name, the kind of device and browser, and either a hashed match of the shared network, the pairing code you typed, or the secret key of a trusted device. It never sees your files or their names, and it keeps no user database. The <a href="/privacy/">privacy page</a> and the <a href="/about/">about page</a> explain it in full.
        </p>
      </section>

      <section aria-labelledby="faq">
        <h2 id="faq">Questions</h2>
        <div class="faq">
          {
            faqs.map((faq) => (
              <details>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="guides">
        <h2 id="guides">Guides from the blog</h2>
        <p class="section-lead">Plain-language explanations of the technology behind sending files between your own devices.</p>
        <PostList posts={featured} />
        <p class="all"><a href="/blog/">See all guides</a></p>
      </section>
    </div>
  </main>
</Base>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead {
    margin: 8px 0 0;
    max-width: 680px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .more {
    width: 100%;
    max-width: 900px;
    margin: var(--space-8) auto 0;
    padding-bottom: var(--space-7);
    text-align: left;
  }

  .more section {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .more section:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .more h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .more p {
    margin: var(--space-2) 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .more .section-lead {
    margin-top: var(--space-1);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-accent);
  }

  .steps h3 {
    margin: var(--space-2) 0 0;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
  }

  .more .steps p {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.6;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-5);
    margin: var(--space-4) 0 0;
  }

  .points dt {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }

  .points dd {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .faq {
    margin-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .faq details {
    border-bottom: 1px solid var(--color-line);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    padding: var(--space-2) 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    flex: none;
    font-size: 24px;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .faq details[open] summary::after {
    content: '\2212';
  }

  .more .faq p {
    margin: 0 0 var(--space-3);
    max-width: 720px;
  }

  .more .all {
    margin-top: var(--space-4);
  }

  .all a {
    font-weight: 700;
  }

  @media (min-width: 721px) and (max-height: 780px) {
    h1 {
      font-size: 36px;
    }
  }

  @media (max-width: 720px) {
    main {
      padding-top: var(--space-5);
    }

    h1 {
      font-size: 34px;
    }

    .more {
      margin-top: var(--space-7);
    }

    .more h2 {
      font-size: 24px;
    }

    .steps,
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
