---
import Base from '../layouts/Base.astro';
import TransferTool from '../components/TransferTool.svelte';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/blog';

const title = 'AnyAirDrop.com: Send Files Between iPhone, Android, Windows and Mac';
const description =
  'Share files between iPhone, Android, Windows and Mac over your Wi-Fi. Free, in the browser, with no app, no upload and no size limit.';

const faqs = [
  {
    q: 'Is AnyAirDrop.com really free?',
    a: 'Yes. There is nothing to buy, no account to create and no app to install. Open the page on both devices and send.',
  },
  {
    q: 'Do my files get uploaded to a server?',
    a: 'No. When both devices can reach each other, your browser connects straight to the other browser and the file goes device to device. Our server only introduces the two devices, and it never sees your files or their names.',
  },
  {
    q: 'Does it work between an iPhone and an Android phone?',
    a: 'Yes. It runs in the browser, so it works between iPhone, Android, Windows, Mac and Linux, in any combination, as long as both devices have a modern browser.',
  },
  {
    q: 'Why can’t my devices see each other?',
    a: 'Usually they are on different networks, or the router stops devices from talking to each other (guest networks often do). Pair the devices with the six-digit code or the QR code instead, or follow the step-by-step troubleshooting guide in the blog.',
  },
];

const featuredSlugs = [
  'transfer-files-between-pc-and-phone-over-wifi',
  'devices-cant-find-each-other-troubleshooting',
  'is-local-file-transfer-safe-encryption-explained',
];
const allPosts = await getPosts();
const featured = featuredSlugs.map((slug) => allPosts.find((post) => post.id === slug)).filter((post) => post !== undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://anyairdrop.com/#website',
      url: 'https://anyairdrop.com/',
      name: 'AnyAirDrop.com',
    },
    {
      '@type': 'Organization',
      '@id': 'https://anyairdrop.com/#organization',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      logo: 'https://anyairdrop.com/icon-512.png',
      founder: { '@id': 'https://anyairdrop.com/about/#founder' },
    },
    {
      '@type': 'WebApplication',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any device with a modern browser',
      browserRequirements: 'Requires JavaScript and WebRTC',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://anyairdrop.com/#organization' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main>
    <h1>Send files to nearby devices.</h1>
    <p class="lead">Open AnyAirDrop.com on both. Your files go straight across your Wi-Fi.</p>

    <TransferTool client:load />
    <noscript><p class="lead">AnyAirDrop.com needs JavaScript to find nearby devices.</p></noscript>

    <div class="more">
      <section aria-labelledby="how">
        <h2 id="how"><svg class="head-ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span>How it works</span></h2>
        <ol class="steps">
          <li>
            <span class="step-ico"><svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="13" height="10" rx="1.5"/><path d="M6 19h5"/><rect x="17" y="8" width="5" height="11" rx="1.2"/></svg></span>
            <h3>Open it on both devices</h3>
            <p>Visit AnyAirDrop.com on the phone and the computer. Devices on the same Wi-Fi appear on the radar by themselves, each with a random name.</p>
          </li>
          <li>
            <span class="step-ico"><svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10"/><path d="M12 10V8.5a1.5 1.5 0 0 1 3 0V11"/><path d="M15 11v-.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L3.5 14.5a1.5 1.5 0 0 1 2.4-1.7L9 16"/></svg></span>
            <h3>Pick the other device</h3>
            <p>Choose the files and tap the device you want to send to. On a different network, type its six-digit code or scan its QR code.</p>
          </li>
          <li>
            <span class="step-ico"><svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.5"/></svg></span>
            <h3>Accept, and it goes straight across</h3>
            <p>Nothing starts until the receiving device taps Accept. Then the files travel from one browser to the other, encrypted.</p>
          </li>
        </ol>
      </section>

      <section aria-labelledby="why">
        <h2 id="why"><svg class="head-ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.5"/></svg><span>Why people use it</span></h2>
        <dl class="points">
          <div>
            <span class="step-ico"><svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10.5 18.5h3"/><path d="m4 4 16 16"/></svg></span>
            <dt>No app, no account</dt>
            <dd>It runs in the browser you already have, on iPhone, Android, Windows, Mac and Linux. There is nothing to install and nothing to sign up for.</dd>
          </div>
          <div>
            <span class="step-ico"><svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="12" r="2.5"/><path d="M8 12h8"/><path d="m13.5 9.5 2.5 2.5-2.5 2.5"/></svg></span>
            <dt>Device to device, encrypted</dt>
            <dd>Files are never uploaded or stored. They go directly between the two browsers, encrypted, and only after the receiver accepts.</dd>
          </div>
          <div>
            <span class="step-ico"><svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12c3-5 6-5 9 0s6 5 9 0"/></svg></span>
            <dt>No size limit from us</dt>
            <dd>Large files stream in pieces, so a long video does not have to fit in memory. Photos, videos, documents and whole folders as a ZIP all work.</dd>
          </div>
          <div>
            <span class="step-ico"><svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="1.8"/><path d="M7.5 7.5a6.4 6.4 0 0 0 0 9M16.5 7.5a6.4 6.4 0 0 1 0 9M4.6 4.6a10.5 10.5 0 0 0 0 14.8M19.4 4.6a10.5 10.5 0 0 1 0 14.8"/></svg></span>
            <dt>Finds devices your way</dt>
            <dd>Automatically on the same Wi-Fi, with a code or QR code across networks, or through trusted devices that find each other every time.</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="private">
        <h2 id="private"><svg class="head-ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg><span>What our server sees</span></h2>
        <p>
          Our server only introduces devices to each other. To do that it briefly sees a device name, the kind of device and browser, and either a hashed match of the shared network, the pairing code you typed, or the secret key of a trusted device. It never sees your files or their names, and it keeps no user database. The <a href="/privacy/">privacy page</a> and the <a href="/about/">about page</a> explain it in full.
        </p>
      </section>

      <section aria-labelledby="faq">
        <h2 id="faq"><svg class="head-ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1.9-1.1 1.8"/><path d="M12 17h.01"/></svg><span>Questions</span></h2>
        <div class="faq">
          {
            faqs.map((faq) => (
              <details>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="guides">
        <h2 id="guides"><svg class="head-ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 5.5v16"/><path d="M9 8h7"/></svg><span>Guides from the blog</span></h2>
        <p class="section-lead">Plain-language explanations of the technology behind sending files between your own devices.</p>
        <PostList posts={featured} />
        <p class="all"><a href="/blog/">See all guides</a></p>
      </section>
    </div>
  </main>
</Base>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead {
    margin: 8px 0 0;
    max-width: 680px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .more {
    width: 100%;
    max-width: 900px;
    margin: var(--space-8) auto 0;
    padding-bottom: var(--space-7);
    text-align: left;
  }

  .more section {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .more section:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .more h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .more p {
    margin: var(--space-2) 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .more .section-lead {
    margin-top: var(--space-1);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .step-ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    color: var(--color-accent);
  }

  .more h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .head-ico {
    flex: none;
    color: var(--color-accent);
  }

  .points dt {
    margin-top: var(--space-2);
  }

  .steps h3 {
    margin: var(--space-2) 0 0;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
  }

  .more .steps p {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.6;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-5);
    margin: var(--space-4) 0 0;
  }

  .points dt {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }

  .points dd {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .faq {
    margin-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .faq details {
    border-bottom: 1px solid var(--color-line);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    padding: var(--space-2) 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    flex: none;
    font-size: 24px;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .faq details[open] summary::after {
    content: '\2212';
  }

  .more .faq p {
    margin: 0 0 var(--space-3);
    max-width: 720px;
  }

  .more .all {
    margin-top: var(--space-4);
  }

  .all a {
    font-weight: 700;
  }

  @media (min-width: 721px) and (max-height: 780px) {
    h1 {
      font-size: 36px;
    }
  }

  @media (max-width: 720px) {
    main {
      padding-top: var(--space-5);
    }

    h1 {
      font-size: 34px;
    }

    .more {
      margin-top: var(--space-7);
    }

    .more h2 {
      font-size: 24px;
    }

    .steps,
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
