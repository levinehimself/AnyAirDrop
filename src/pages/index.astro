---
import Base from '../layouts/Base.astro';
import TransferTool from '../components/TransferTool.svelte';

const title = 'AnyAirDrop.com: Send Files Between iPhone, Android, Windows and Mac';
const description =
  'Share files between iPhone, Android, Windows and Mac over your Wi-Fi. Free, in the browser, with no app, no upload and no size limit.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://anyairdrop.com/#website',
      url: 'https://anyairdrop.com/',
      name: 'AnyAirDrop.com',
    },
    {
      '@type': 'Organization',
      '@id': 'https://anyairdrop.com/#organization',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      logo: 'https://anyairdrop.com/favicon.svg',
      founder: { '@id': 'https://anyairdrop.com/about/#founder' },
    },
    {
      '@type': 'WebApplication',
      name: 'AnyAirDrop.com',
      url: 'https://anyairdrop.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any device with a modern browser',
      browserRequirements: 'Requires JavaScript and WebRTC',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://anyairdrop.com/#organization' },
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main>
    <h1>Send files to nearby devices.</h1>
    <p class="lead">Open AnyAirDrop.com on both. Your files go straight across your Wi-Fi.</p>

    <TransferTool client:load />
    <noscript><p class="lead">AnyAirDrop.com needs JavaScript to find nearby devices.</p></noscript>

    <ul class="benefits" aria-label="Why AnyAirDrop.com">
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M2 9h20M6 6.5h.01M9 6.5h.01" /></svg>
        <strong>No app or account</strong>
      </li>
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.6 17A5 5 0 0 0 18 10h-1.3a8 8 0 0 0-7-6M5 5a8 8 0 0 0 4 15h9a5 5 0 0 0 1.7-.3" /><path d="M2 2l20 20" /></svg>
        <strong>Nothing uploaded</strong>
      </li>
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16c5 0 7-8 12-8a4 4 0 0 1 0 8c-5 0-7-8-12-8a4 4 0 1 0 0 8" /></svg>
        <strong>No size limit</strong>
      </li>
    </ul>
  </main>
</Base>

<style is:global>
  /* Desktop: the whole homepage fits in the window, with no page scrolling. */
  @media (min-width: 721px) and (min-height: 640px) {
    body {
      height: 100dvh;
      overflow: hidden;
    }

    /* Content never overflows at normal sizes; if a tiny window ever makes it, it can
       still scroll, but without drawing a scrollbar. */
    body > main {
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: none;
    }

    body > main::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead {
    margin: 8px 0 0;
    max-width: 680px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .benefits {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: var(--space-3) 0 var(--space-2);
    width: 100%;
    max-width: 1000px;
    border-top: 1px solid var(--color-line);
    display: flex;
    justify-content: center;
    gap: 8px var(--space-5);
    flex-wrap: wrap;
  }

  .benefits li {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 15px;
    color: var(--color-link);
  }

  .benefits strong {
    font-weight: 700;
    color: var(--color-text);
  }

  /* Short desktop windows: drop the benefit row so the tool stays in view. */
  @media (min-width: 721px) and (max-height: 780px) {
    .benefits {
      display: none;
    }

    h1 {
      font-size: 36px;
    }
  }

  @media (max-width: 720px) {
    main {
      padding-top: var(--space-5);
    }

    h1 {
      font-size: 34px;
    }

    /* Phones: the three benefits sit side by side, icon above label, to save height. */
    .benefits {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: var(--space-1);
      margin-top: var(--space-3);
      padding: var(--space-2) 0;
    }

    .benefits li {
      flex: 1 1 0;
      min-width: 0;
      flex-direction: column;
      gap: 4px;
      font-size: 13px;
      line-height: 1.25;
      text-align: center;
    }
  }
</style>
