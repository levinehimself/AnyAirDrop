---
import { formatDate } from '../lib/blog';

interface Props {
  devices: string[];
  network: string;
  files: string;
  date: Date;
}

const { devices, network, files, date } = Astro.props;
---

<aside class="tested" aria-labelledby="tested-title">
  <h2 id="tested-title" class="tested-title">How we tested</h2>
  <dl>
    <dt>Devices</dt>
    <dd>
      <ul>
        {devices.map((device) => <li>{device}</li>)}
      </ul>
    </dd>
    <dt>Network</dt>
    <dd>{network}</dd>
    <dt>Files used</dt>
    <dd>{files}</dd>
    <dt>Tested on</dt>
    <dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd>
  </dl>
</aside>

<style>
  .tested {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line-strong);
    border-left: 4px solid var(--color-brand);
    border-radius: 12px;
  }

  .tested-title {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px var(--space-3);
    margin: var(--space-1) 0 0;
    font-size: 15px;
    line-height: 1.55;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  ul {
    margin: 0;
    padding-left: 18px;
  }

  @media (max-width: 720px) {
    dl {
      grid-template-columns: 1fr;
      gap: 0;
    }

    dd {
      margin-bottom: var(--space-1);
    }
  }
</style>
