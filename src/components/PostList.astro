---
import { Image } from 'astro:assets';
import type { Post } from '../lib/blog';

interface Props {
  posts: Post[];
  /** The first images load at once; lower ones wait until they scroll into view. */
  eager?: number;
}

const { posts, eager = 0 } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post, i) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <span class="thumb">
            {/* The title below names the post, so the picture adds no extra words for screen readers. */}
            <Image src={post.data.heroImage} alt="" widths={[360, 720]} sizes="(min-width: 1000px) 330px, (min-width: 640px) 45vw, 92vw" loading={i < eager ? 'eager' : 'lazy'} />
          </span>
          <span class="title">{post.data.title}</span>
          <span class="desc">{post.data.description}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* The page layout styles every list inside its text column, so these win with !important. */
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0 !important;
    list-style: none;
  }

  .posts li {
    margin: 0 !important;
    padding: 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .posts a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface);
    transition: border-color var(--dur-color) ease;
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .posts a:hover .thumb {
    border-color: var(--color-link);
  }

  .title {
    display: block;
    margin-top: var(--space-2);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text);
  }

  .posts a:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 4px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .posts a:focus-visible {
    outline-offset: 4px;
    border-radius: 10px;
  }
</style>
