---
import { ADS_ENABLED, ADSENSE_PUBLISHER_ID, ADSENSE_SLOTS } from '../config';

interface Props {
  position: keyof typeof ADSENSE_SLOTS;
}

const { position } = Astro.props;
const slot = ADSENSE_SLOTS[position];
---

{
  ADS_ENABLED && slot && (
    <aside class="ad-slot" data-ad-position={position} aria-label="Advertisement">
      <p class="ad-label">Advertisement</p>
      <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_PUBLISHER_ID} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true" />
    </aside>
  )
}

<style>
  .ad-slot {
    margin: var(--space-5) 0;
    padding: var(--space-2) var(--space-2) var(--space-3);
    border: 1px dashed var(--color-line-strong);
    border-radius: 12px;
    background: var(--color-line);
    text-align: center;
    min-height: 120px;
    overflow: hidden;
  }

  .ad-label {
    margin: 0 0 var(--space-1);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
