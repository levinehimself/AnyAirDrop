---
import '@fontsource-variable/urbanist';
import '@fontsource-variable/unbounded';
import '../styles/global.css';
import { ADS_ENABLED, ADSENSE_PUBLISHER_ID } from '../config';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  /** Keep a page out of search results, e.g. while it has no real content yet. */
  noindex?: boolean;
  /** "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** Absolute URL of the share image. */
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** Load the ad script. Only guide pages do: never the homepage or anything that embeds the transfer tool. */
  ads?: boolean;
}

const { title, description, jsonLd, noindex = false, ogType = 'website', ogImage, publishedTime, modifiedTime, ads = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <!-- Sets the theme before the first paint, so there is no flash. A saved choice wins,
         then the device's preference, and light if neither can be read. -->
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('anyairdrop:theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="AnyAirDrop.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* Proves ownership to AdSense on every page without loading any ads. */}
    {ADS_ENABLED && <meta name="google-adsense-account" content={ADSENSE_PUBLISHER_ID} />}
    {
      ADS_ENABLED && ads && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="AnyAirDrop.com home">
        <svg class="mark" width="32" height="32" viewBox="2.9 -1.9 48 48" fill="none" aria-hidden="true">
          <circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="3.5" />
          <circle cx="24" cy="24" r="4.6" fill="currentColor" />
          <path d="M32.87 4.97A21 21 0 0 1 44.92 22.17" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
        </svg>
        <span class="wordmark" aria-hidden="true">AnyAirDrop<span class="tld">.com</span></span>
      </a>
      <nav aria-label="Main">
        <a href="/blog/">Blog</a>
        <button type="button" class="theme" id="theme-toggle" aria-label="Switch to dark theme">
          <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" /></svg>
          <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <p>AnyAirDrop.com is an independent service, not affiliated with or endorsed by Apple Inc. Apple’s trademarks belong to Apple Inc.</p>
      <nav aria-label="Company">
        <a href="/about/">About</a>
        <a href="/editorial-policy/">Editorial policy</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </nav>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.getElementById('theme-toggle');
        function label() {
          button.setAttribute('aria-label', root.getAttribute('data-theme') === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        }
        label();
        button.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('anyairdrop:theme', next);
          } catch (e) {}
          label();
        });
        // Until the visitor picks a theme, follow the device when it changes.
        if (window.matchMedia) {
          matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (event) {
            var saved = null;
            try {
              saved = localStorage.getItem('anyairdrop:theme');
            } catch (e) {}
            if (saved !== 'light' && saved !== 'dark') {
              root.setAttribute('data-theme', event.matches ? 'dark' : 'light');
              label();
            }
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  /* The header and footer span the window, so the logo and menu sit near the corners and the
     content stays centered between them. A cap keeps them from drifting apart on ultrawide
     screens. */
  .site-header,
  .site-footer {
    width: 100%;
    max-width: 2000px;
    margin: 0 auto;
    padding: var(--space-4) clamp(var(--space-4), 3vw, 56px);
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  @media (min-width: 721px) {
    .site-header {
      padding-top: var(--space-2);
      padding-bottom: var(--space-2);
    }
  }

  @media (max-width: 720px) {
    .site-header,
    .site-footer {
      padding-inline: var(--space-4);
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    text-decoration: none;
    min-height: 44px;
  }

  .mark {
    flex: none;
    color: var(--color-brand);
  }

  /* Unbounded is very wide, so it is set smaller than the body text would be. */
  .wordmark {
    font-family: var(--font-brand);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .tld {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding: 10px 0;
  }

  .site-header nav a:hover {
    color: var(--color-text);
  }

  .theme {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--dur-color) ease, background-color var(--dur-color) ease;
  }

  .theme:hover {
    color: var(--color-text);
    background: var(--color-line);
  }

  .theme .sun,
  :global(:root[data-theme='dark']) .theme .moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme .sun {
    display: block;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-3);
    gap: 6px var(--space-4);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-footer a {
    color: var(--color-text-muted);
  }

  .site-footer p {
    flex: 1 1 360px;
    margin: 0;
    font-size: 12px;
  }
</style>
